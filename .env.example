# ==========================================
# Application Configuration
# ==========================================
PORT=8080
# Base domain used to construct full shortened URLs (e.g., http://localhost:8080/ or https://api.yourdomain.com/)
APP_DOMAIN=http://localhost:8080/
# Frontend application URL for redirects (e.g., expired links redirect to ${FRONTEND_URL}/link-expired)
FRONTEND_URL=http://localhost:5173
# CORS Configuration (Comma-separated list of allowed origins, e.g. http://localhost:5173,https://your-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# DB_HOST: use 'postgres' for Docker Compose, or 'localhost' for local development
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bitly_clone
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here
# Optional: Directly provide full JDBC URL (useful on Render, Railway, Neon, Supabase)
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/bitly_clone

# ==========================================
# Redis Configuration
# ==========================================
# REDIS_HOST: use 'redis' for Docker Compose, or 'localhost' for local development
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT Security Configuration
# ==========================================
# Secret key (at least 256-bit Hex / Base64 string for HS256 algorithm)
JWT_SECRET=your_256_bit_jwt_secret_key_here
# Access token expiration time in milliseconds (1 hour = 3600000)
JWT_EXPIRATION=3600000
# Refresh token expiration time in milliseconds (7 days = 604800000)
JWT_REFRESH_EXPIRATION=604800000

# ==========================================
# Rate Limiting Configuration (Redis Token Bucket)
# ==========================================
# Master switch to enable or disable rate limiting
RATE_LIMIT_ENABLED=true
# Authentication endpoints (/api/v1/auth/login, /api/v1/auth/register) per IP
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_DURATION=60
# Short URL redirection (/{shortCode}) per IP to prevent scraper bot abuse
RATE_LIMIT_REDIRECT_CAPACITY=100
RATE_LIMIT_REDIRECT_DURATION=60
# Short URL creation (POST /api/v1/urls) per User ID
RATE_LIMIT_CREATE_URL_CAPACITY=20
RATE_LIMIT_CREATE_URL_DURATION=60
# General API endpoints (/api/v1/**) per User / IP
RATE_LIMIT_GENERAL_CAPACITY=120
RATE_LIMIT_GENERAL_DURATION=60
