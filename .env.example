# ==========================================
# Application Configuration
# ==========================================
PORT=8080
# Base domain used to construct full shortened URLs (e.g., http://localhost:8080/ or https://domain.com/)
APP_DOMAIN=http://localhost:8080/

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# DB_HOST: use 'postgres' for Docker Compose, or 'localhost' for local development
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bitly_clone
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# ==========================================
# Redis Configuration
# ==========================================
# REDIS_HOST: use 'redis' for Docker Compose, or 'localhost' for local development
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# JWT Security Configuration
# ==========================================
# Secret key (at least 256-bit Hex / Base64 string for HS256 algorithm)
JWT_SECRET=your_256_bit_jwt_secret_key_here
# Access token expiration time in milliseconds (1 hour = 3600000)
JWT_EXPIRATION=3600000
# Refresh token expiration time in milliseconds (7 days = 604800000)
JWT_REFRESH_EXPIRATION=604800000
